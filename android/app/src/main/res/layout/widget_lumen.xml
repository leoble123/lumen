<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp" android:background="@drawable/widget_bg">
    <ImageView android:id="@+id/w_art" android:layout_width="56dp" android:layout_height="56dp" android:scaleType="centerCrop" android:clipToOutline="true" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="6dp">
        <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/w_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B3FFFFFF" android:textSize="13sp" android:singleLine="true" android:ellipsize="end" />
    </LinearLayout>
    <ImageView android:id="@+id/w_prev" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_w_prev" android:contentDescription="Previous" />
    <ImageView android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:padding="9dp" android:src="@drawable/ic_w_play" android:contentDescription="Play or pause" />
    <ImageView android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_w_next" android:contentDescription="Next" />
</LinearLayout>
